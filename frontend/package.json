{
  "name": "frontend",
  "version": "1.0.11",
  "description": "Punto de Venta",
  "main": "main_electron.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
