      }
    ],
    "win": {
      "target": "nsis",
      "icon": "logo20dejunio.ico"
    }
  },
  "author": "Orlando Repetto",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
